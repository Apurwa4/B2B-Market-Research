# Local development works without any environment variables.
MARKET_RESEARCH_DATABASE_PATH=.local/market-research.sqlite
# Keep localhost on SQLite while preparing the cloud transfer. Vercel always uses Supabase.
WORKSPACE_DATABASE=local

# Required on Vercel. All keys are server-side; never use NEXT_PUBLIC for the secret.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Public by default: anyone can view, add, and edit companies without signing in.
# Set to private to restore invited-email sign-in on pages and API requests.
WORKSPACE_ACCESS_MODE=public
# Comma-separated invited team emails. Only applies in private mode.
WORKSPACE_ALLOWED_EMAILS=
# Your canonical https://...vercel.app origin (used for sign-in email callbacks).
WORKSPACE_SITE_URL=
